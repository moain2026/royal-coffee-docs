{
  "name": "royal-coffee",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name royal-coffee",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl -sS -o /dev/null -w \"%{http_code}\n\" http://localhost:3000",
    "build:vercel": "BUILD_TARGET=vercel vite build",
    "deploy:vercel": "BUILD_TARGET=vercel vite build && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}